{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Restro Pro POS",
  "version": "0.1.0",
  "identifier": "com.restropro.pos",
  "build": {
    "frontendDist": "https://restropro-eta.vercel.app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Restro Pro POS",
        "url": "https://restropro-eta.vercel.app",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/logo.png"],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}