{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Main window (Android): the bundle is served at http://app.localhost",
  "windows": [
    "main"
  ],
  "platforms": [
    "android",
    "iOS"
  ],
  "remote": {
    "urls": [
      "http://app.localhost/*",
      "app://*"
    ]
  },
  "permissions": [
    "core:default",
    {
      "identifier": "core:app:default"
    },
    "allow-print-raw",
    "allow-test-printer-connection",
    "allow-list-windows-printers",
    "allow-check-windows-printer",
    "allow-print-raw-windows",
    "allow-list-serial-ports",
    "allow-check-serial-port",
    "allow-print-raw-serial",
    "allow-list-usb-printers",
    "allow-print-raw-usb",
    "allow-secure-set",
    "allow-secure-get",
    "allow-secure-delete",
    "allow-get-device-info",
    "allow-get-cached-staff-list",
    "allow-verify-staff-pin",
    "allow-activate-device",
    "allow-get-local-session",
    "allow-staff-logout",
    "allow-sync-now",
    "allow-get-sync-status",
    "allow-get-cached-data",
    "allow-search-local-customers",
    "allow-create-local-sale",
    "allow-api-request",
    "allow-check-online"
  ]
}